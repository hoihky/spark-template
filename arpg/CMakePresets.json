{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "SparkArpg with shared SparkEngine (CLion default)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPARK_ROOT": "${sourceDir}/../../spark",
        "SPARK_BUILD_SCRIPT_HOST": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized SparkArpg build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPARK_ROOT": "${sourceDir}/../../spark",
        "SPARK_BUILD_SCRIPT_HOST": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
